{
  "name": "simple-agent-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:live": "tsx scripts/live.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test:unit"
  },
  "dependencies": {
    "@anvia/core": "1.17.1",
    "@anvia/openai": "1.3.5",
    "@anvia/studio": "1.3.20",
    "openai": "7.43.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anvia/server": "1.3.5",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
